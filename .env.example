# elko-fatcat-mcp environment variables
# Copy this file to .env and fill in the values you need.
# All variables are optional unless noted.

# Pro key — HMAC secret for higher rate limits (contact elko.ai)
ELKO_KEY_SECRET=

# Pro key revocation endpoint (only needed with ELKO_KEY_SECRET)
ELKO_REVOCATION_URL=

# Congress.gov API key — required for legislation ingest
# Free signup: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# FEC API key — optional, defaults to DEMO_KEY (lower rate limits)
# Free signup: https://api.data.gov/signup/
FEC_API_KEY=
